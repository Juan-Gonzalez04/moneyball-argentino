# ==========================================
# MoneyBall Argentino - Environment Config
# ==========================================

# Storage Paths
# Desarrollo local (notebook / workstation): ./data
# Servidor de producción (Argos bare-metal): /data/scouting
DATA_PATH=./data

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=afa_data
DB_USER=juan
DB_PASSWORD=changeme_in_production
DB_URL=postgresql://juan:changeme_in_production@postgres:5432/afa_data

# Data Ingestion (Fuente de Datos)
# URL del endpoint JSON del proveedor de estadísticas deportivas
AFA_PLAYERS_STATS_URL=https://your-data-provider-domain/path/to/playersStatsFull.json
# SEASON_YEAR=2026 # Opcional: sobreescribe el año de temporada (por defecto infiere de la API)

# Python Runtime
PYTHONUNBUFFERED=1
